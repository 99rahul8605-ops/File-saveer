# Telegram Bot Token (BotFather se milega)
BOT_TOKEN=your_telegram_bot_token_here

# Aapki Render app ka URL (deploy karne ke baad milega)
BASE_URL=https://your-app-name.onrender.com

# MongoDB URI (MongoDB Atlas se milega)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/telegram_files?retryWrites=true&w=majority

# Port (Render automatically set karta hai)
PORT=3000
